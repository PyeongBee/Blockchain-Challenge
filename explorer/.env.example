# 탐색기가 처음 접속할 RPC 주소 (화면 상단 ⚙에서 바꿀 수도 있음)
VITE_RPC_URL=http://127.0.0.1:8545

# MTK 컨트랙트 주소. 로컬 노드를 새로 띄우고 첫 배포하면 아래 주소가 나온다.
VITE_TOKEN_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# 주소 페이지에서 ETH tx를 찾으려고 거슬러 올라갈 블록 수 / Transfer 로그를 조회할 블록 범위
VITE_TX_SCAN_BLOCKS=100
VITE_LOG_SCAN_BLOCKS=10000
