# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤, 실제 값을 채우세요.
# .env 파일 자체는 .gitignore에 의해 깃에 절대 올라가지 않습니다. (개인키 유출 방지)
#
# 사용법: cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

# -----------------------------------------------------------------------------
# 배포에 사용할 지갑의 개인키 (private key)
# -----------------------------------------------------------------------------
# ⚠️ 절대 메인넷에서 실제 자산이 들어있는 지갑의 개인키를 쓰지 마세요!
# 테스트용으로 새 지갑을 하나 만들어서(MetaMask에서 "계정 추가"), 그 지갑의
# 개인키만 여기 넣으세요. 테스트넷 faucet도 이 지갑 주소로 받으면 됩니다.
#
# MetaMask에서 개인키 확인: 계정 메뉴 → 계정 세부 정보 → 개인 키 내보내기
# 0x로 시작하는 64자리 16진수 문자열입니다.
PRIVATE_KEY=

# -----------------------------------------------------------------------------
# 각 테스트넷의 RPC 주소 (비워두면 hardhat.config.js의 공개 기본값을 씁니다.
# 공개 RPC는 느리거나 가끔 막힐 수 있어서, 안정적으로 쓰려면 Alchemy/Infura 등에서
# 무료 API 키를 받아 전용 RPC 주소를 넣는 걸 추천합니다.)
# -----------------------------------------------------------------------------
AMOY_RPC_URL=
SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# -----------------------------------------------------------------------------
# 배포 후 소스코드를 블록 익스플로러에 Verify(공개 인증)하고 싶을 때 필요.
# https://etherscan.io/apis 에서 무료로 발급받는 API 키 하나로
# Etherscan v2 통합을 통해 Polygonscan, Arbiscan 등도 대부분 함께 커버됩니다.
# -----------------------------------------------------------------------------
ETHERSCAN_API_KEY=
